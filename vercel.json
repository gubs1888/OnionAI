{
  "buildCommand": "cd mobile && npm install && npx expo export -p web",
  "outputDirectory": "mobile/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://onion-quality-ai.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
