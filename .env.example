# ===========================================================
# Onion Quality AI — environment template
# Copy to `.env` and adjust.  NEVER commit your real .env.
#   cp .env.example .env
# ===========================================================

# ---------- Global ----------
# DEMO_MODE=true  -> backend returns deterministic synthetic results
#                    (clearly marked DEMO DATA). Set to false once the real
#                    YOLO model (ml/models/onion_yolo.pt) is available.
DEMO_MODE=true
DEBUG=true

# ---------- Backend ----------
API_PREFIX=/api
# IMPORTANT: change JWT_SECRET for anything beyond local development.
JWT_SECRET=change-me-dev-secret-only
ACCESS_TOKEN_EXPIRE_MINUTES=720
CORS_ORIGINS=*

# ---------- Database ----------
# Docker Compose / PostgreSQL (recommended):
DATABASE_URL=postgresql+psycopg2://onion:onion_pass@localhost:5432/onion_quality
# Local dev WITHOUT Docker (SQLite fallback — zero setup):
# DATABASE_URL=sqlite:///./onion_quality_dev.db

# Postgres container settings (used by docker-compose.yml)
POSTGRES_USER=onion
POSTGRES_PASSWORD=onion_pass
POSTGRES_DB=onion_quality
POSTGRES_PORT=5432
BACKEND_PORT=8000

# ---------- ML ----------
# Where the trained YOLO11n weights live (TEAM A produces this file).
# Until it exists, DEMO_MODE=true keeps the whole app testable.
MODEL_PATH=./ml/models/onion_yolo.pt

# ---------- Mobile (React Native / Expo) ----------
# Base URL the mobile app uses to reach the backend.
# - iOS simulator / web:      http://localhost:8000
# - Android emulator:         http://10.0.2.2:8000
# - Physical device:          http://<YOUR-LAN-IP>:8000
API_BASE_URL=http://localhost:8000
EXPO_PUBLIC_API_URL=http://localhost:8000
