# ==========================================================
# Onion Quality AI — root .gitignore
# ==========================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---------- Environment & secrets (NEVER commit real .env) ----------
.env
.env.local
.env.*.local

# ---------- Node / Expo / React Native ----------
node_modules/
.expo/
web-build/
dist/
!mobile/dist/
npm-debug.log*
yarn-error.log*
package-lock.json.bak

# ---------- Databases (local dev) ----------
*.db
*.sqlite3

# ---------- Runtime artifacts ----------
backend/uploads/*
!backend/uploads/.gitkeep
backend/reports/*
!backend/reports/.gitkeep

# ---------- ML artifacts ----------
# Trained weights are too big for plain git — use Git LFS or a shared drive.
ml/models/*.pt
!ml/models/onion_yolo.pt
ml/models/*.onnx
ml/models/*.safetensors
ml/runs/
ml/models/eval_report.json
ml/dataset/raw/*
ml/dataset/processed/*
!ml/dataset/raw/.gitkeep
!ml/dataset/processed/.gitkeep
# Large local-only data: rebuilt via fetch_datasets/merge_datasets; Colab zip
# lives outside the repo. Holdout IMAGES regenerable from backend/uploads via
# ml/holdout_staged/manifest.json -- labels + manifest ARE tracked.
ml/dataset_raw/
ml/dataset_v2/
ml/onion_dataset/
ml/onion_dataset.zip
ml/holdout_staged/images/
runs/
yolo11n.pt
yolo11n/
# Local-only runtime + derived data (rebuild via scripts/)
logs/
ml/dataset_synth/

# ---------- OS / Editor ----------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# ---------- Raw dataset archives (live on Drive, not in git) ----------
/incoming/
